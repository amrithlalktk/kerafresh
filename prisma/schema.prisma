generator client {
  provider      = "prisma-client-js"
  // rhel-openssl-3.0.x: Vercel's Node.js serverless runtime.
  // linux-musl-openssl-3.0.x: the Alpine-based Docker image.
  // native: local dev.
  binaryTargets = ["native", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // Pooled connection string (e.g. Neon's `-pooler` host, or PgBouncer) —
  // used for normal runtime queries from many concurrent serverless
  // functions.
  url       = env("DATABASE_URL")
  // Unpooled/direct connection string — `prisma migrate deploy` needs
  // this because poolers like PgBouncer don't support the advisory locks
  // migrations take.
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  STAFF
}

// Category/Transaction are expense-only going forward — income is tracked
// via Sale. The type field stays for minimal churn but only EXPENSE is
// ever created now.
enum TransactionType {
  INCOME
  EXPENSE
}

enum PartyType {
  CUSTOMER
  SUPPLIER
  BOTH
}

enum PaymentMethod {
  CASH
  BANK
}

enum PartyPaymentDirection {
  RECEIVED // an advance received from the party (e.g. a customer prepaying)
  PAID // an advance paid to the party (e.g. prepaying a supplier)
}

enum PaymentSource {
  CASH // fresh money changing hands right now
  ADVANCE // settled against a party's existing advance credit — see PartyPayment
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  // Null until the user follows their invite-setup link. Admin-created
  // accounts start this way instead of an admin-chosen temporary password.
  passwordHash String?
  role         Role          @default(STAFF)
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  transactions        Transaction[]
  sales               Sale[]
  purchases           Purchase[]
  advancePayments     PartyPayment[]
  passwordResetTokens PasswordResetToken[]
}

// A one-time link emailed to a user who forgot their password. `tokenHash`
// is a fast SHA-256 hash (not bcrypt) of the raw token that's actually in
// the emailed URL — that raw token never touches the database, and a fast
// hash is fine here since the token itself is high-entropy random, unlike a
// user-chosen password that needs slow hashing to resist guessing.
model PasswordResetToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([expiresAt])
}

model Category {
  id           String          @id @default(cuid())
  name         String
  type         TransactionType
  createdAt    DateTime        @default(now())
  transactions Transaction[]

  @@unique([name, type])
}

model Transaction {
  id            String          @id @default(cuid())
  date          DateTime
  description   String
  amountCents   Int
  type          TransactionType
  category      Category        @relation(fields: [categoryId], references: [id])
  categoryId    String
  recordedBy    User            @relation(fields: [userId], references: [id])
  userId        String
  paymentMethod PaymentMethod?
  notes         String?
  createdAt     DateTime        @default(now())

  @@index([date])
  @@index([type])
}

model Party {
  id                  String     @id @default(cuid())
  name                String
  type                PartyType  @default(BOTH)
  phone               String?
  email               String?
  address             String?
  gstNumber           String?
  notes               String?
  openingBalanceCents Int        @default(0)
  createdAt           DateTime   @default(now())
  sales               Sale[]
  purchases           Purchase[]
  advancePayments     PartyPayment[]
}

// Money exchanged with a party outside of any specific Sale/Purchase — most
// commonly an advance a customer pays before an order, or an advance paid to
// a supplier before delivery. Included in the party's running balance
// alongside unpaid Sale/Purchase amounts (see getPartyBalanceMap).
model PartyPayment {
  id            String                @id @default(cuid())
  party         Party                 @relation(fields: [partyId], references: [id], onDelete: Cascade)
  partyId       String
  date          DateTime
  direction     PartyPaymentDirection
  amountCents   Int
  paymentMethod PaymentMethod         @default(CASH)
  notes         String?
  recordedBy    User                  @relation(fields: [userId], references: [id])
  userId        String
  createdAt     DateTime              @default(now())

  @@index([date])
}

model Item {
  id                 String         @id @default(cuid())
  name               String
  unit               String         @default("pcs")
  salePriceCents     Int
  purchasePriceCents Int
  openingStockQty    Int            @default(0)
  lowStockThreshold  Int?
  // When true, a Sale/Purchase line for this item asks for an FFA grade
  // (FFA-1..FFA-10) — a quality rating, not every item needs one.
  ffaGraded          Boolean        @default(false)
  createdAt          DateTime       @default(now())
  saleItems          SaleItem[]
  purchaseItems      PurchaseItem[]
}

// A manageable list of extra charge types (lorry rent, packing charge,
// coolie, etc.) that can be added on top of a Sale/Purchase's item total.
// A charge line always stores a denormalized `label` snapshot (like
// SaleItem.priceCents snapshots an item's price), so historical charges
// stay readable even if a ChargeType is later renamed or deleted.
model ChargeType {
  id              String           @id @default(cuid())
  name            String           @unique
  createdAt       DateTime         @default(now())
  saleCharges     SaleCharge[]
  purchaseCharges PurchaseCharge[]
}

model Sale {
  id            String         @id @default(cuid())
  // Sequential invoice number for this sale, assigned by the API as
  // (current max + 1) — its own series, separate from Purchase's.
  billNumber    Int            @unique @default(0)
  date          DateTime
  party         Party?         @relation(fields: [partyId], references: [id])
  partyId       String?
  items         SaleItem[]
  charges       SaleCharge[]
  payments      SalePayment[]
  totalCents    Int
  // Maintained cache = sum of `payments`, kept in sync whenever a payment
  // is added/edited/deleted — never edited directly once the sale exists,
  // so it can't drift from the payment history.
  paidCents     Int            @default(0)
  paymentMethod PaymentMethod  @default(CASH)
  notes         String?
  recordedBy    User           @relation(fields: [userId], references: [id])
  userId        String
  createdAt     DateTime       @default(now())

  @@index([date])
}

// One installment against a Sale — recorded with its own date/amount/method
// so a bill can be paid off over several visits instead of one lump sum.
model SalePayment {
  id            String        @id @default(cuid())
  sale          Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId        String
  date          DateTime
  amountCents   Int
  paymentMethod PaymentMethod @default(CASH)
  // ADVANCE means this amount was already accounted for as a PartyPayment
  // (RECEIVED) earlier — see getPartyBalanceMap, which nets ADVANCE-sourced
  // sale payments back out of the party's advance pool so it isn't counted
  // as both "still available" and "used to pay this bill".
  source        PaymentSource @default(CASH)
  notes         String?
  createdAt     DateTime      @default(now())

  @@index([date])
}

model SaleItem {
  id         String @id @default(cuid())
  sale       Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId     String
  item       Item   @relation(fields: [itemId], references: [id])
  itemId     String
  // KG, can be fractional (e.g. 1.5).
  quantity   Float
  priceCents Int
  // Pre-tax: quantity * priceCents.
  lineTotalCents Int
  // GST-style rate for this line (e.g. 18 for 18%) — 0 for no tax.
  taxPercent Float @default(0)
  // round(lineTotalCents * taxPercent / 100), stored so historical bills
  // don't recompute differently if the item's price changes later.
  taxCents   Int     @default(0)
  // FFA grade (e.g. "FFA-3") — only set when the item is ffaGraded.
  ffaGrade   String?
}

model SaleCharge {
  id           String      @id @default(cuid())
  sale         Sale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId       String
  chargeType   ChargeType? @relation(fields: [chargeTypeId], references: [id])
  chargeTypeId String?
  label        String
  amountCents  Int
}

model Purchase {
  id            String            @id @default(cuid())
  // Sequential bill number for this purchase — own series, separate from
  // Sale's (see Sale.billNumber).
  billNumber    Int               @unique @default(0)
  date          DateTime
  party         Party?            @relation(fields: [partyId], references: [id])
  partyId       String?
  items         PurchaseItem[]
  charges       PurchaseCharge[]
  payments      PurchasePayment[]
  totalCents    Int
  // Maintained cache = sum of `payments` — see Sale.paidCents.
  paidCents     Int               @default(0)
  paymentMethod PaymentMethod     @default(CASH)
  notes         String?
  recordedBy    User              @relation(fields: [userId], references: [id])
  userId        String
  createdAt     DateTime          @default(now())

  @@index([date])
}

// One installment against a Purchase — see SalePayment.
model PurchasePayment {
  id            String        @id @default(cuid())
  purchase      Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  purchaseId    String
  date          DateTime
  amountCents   Int
  paymentMethod PaymentMethod @default(CASH)
  notes         String?
  createdAt     DateTime      @default(now())

  @@index([date])
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  purchaseId String
  item       Item     @relation(fields: [itemId], references: [id])
  itemId     String
  // KG, can be fractional (e.g. 1.5).
  quantity   Float
  priceCents Int
  // Pre-tax: quantity * priceCents.
  lineTotalCents Int
  // GST-style rate for this line (e.g. 18 for 18%) — 0 for no tax.
  taxPercent Float   @default(0)
  // round(lineTotalCents * taxPercent / 100) — see SaleItem.taxCents.
  taxCents   Int     @default(0)
  // FFA grade (e.g. "FFA-3") — only set when the item is ffaGraded.
  ffaGrade   String?
}

model PurchaseCharge {
  id           String      @id @default(cuid())
  purchase     Purchase    @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  purchaseId   String
  chargeType   ChargeType? @relation(fields: [chargeTypeId], references: [id])
  chargeTypeId String?
  label        String
  amountCents  Int
}
