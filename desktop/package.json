{
  "name": "kerafresh-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop shell for Kerafresh (kerafresh.vercel.app)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.kerafresh.desktop",
    "productName": "Kerafresh",
    "directories": {
      "output": "dist"
    },
    "files": ["main.js", "build/icon.png"],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Kerafresh-Setup.exe"
    }
  }
}
